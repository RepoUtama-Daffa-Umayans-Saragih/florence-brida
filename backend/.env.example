# Backend Port (default 3001 agar tidak bentrok dengan frontend)
PORT=3001

# PostgreSQL/PostGIS connection
DATABASE_URL="postgresql://florence:florence_dev@localhost:5433/florence?schema=public"

# Redis cache (optional; PostgreSQL remains the durable store)
REDIS_URL="redis://localhost:6379"

# Google Maps Platform server key (Routes API only, IP-restricted)
GMAPS_SERVER_KEY=""
